{
  "name": "adult-live-platform",
  "version": "1.0.0",
  "description": "Production-grade adult live creator platform with authentication",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node src/server.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/server.js",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:seed": "ts-node scripts/seed.ts",
    "prisma:studio": "prisma studio",
    "lint": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/niswell/niswell.git"
  },
  "keywords": [
    "streaming",
    "live",
    "creator",
    "platform",
    "authentication"
  ],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/niswell/niswell/issues"
  },
  "homepage": "https://github.com/niswell/niswell#readme",
  "dependencies": {
    "@prisma/client": "^5.7.1",
    "argon2": "^0.31.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.0",
    "qrcode": "^1.5.3",
    "speakeasy": "^2.0.0",
    "stripe": "^14.0.0",
    "uuid": "^9.0.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.11",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.10.6",
    "@types/qrcode": "^1.5.2",
    "@types/speakeasy": "^2.0.10",
    "@types/uuid": "^9.0.7",
    "jest": "^29.7.0",
    "prettier": "^3.1.1",
    "prisma": "^5.7.1",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
