// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User account with roles and permissions
model User {
  id                    String      @id @default(cuid())
  email                 String      @unique
  passwordHash          String
  emailVerified         Boolean     @default(false)
  emailVerifiedAt       DateTime?

  // Profile
  displayName           String?
  avatar                String?

  // Account state: pending, active, restricted, suspended, banned, deleted, legal_hold
  accountState          String      @default("pending")
  accountStateChangedAt DateTime    @default(now())

  // MFA
  mfaEnabled            Boolean     @default(false)
  totpSecret            String?
  backupCodes           String[]    @default([])

  // Security
  lastLoginAt           DateTime?
  lastLoginIp           String?
  lastLoginUserAgent    String?
  passwordChangedAt     DateTime?
  accountLockedUntil    DateTime?
  failedLoginAttempts   Int         @default(0)

  // Audit
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  deletedAt             DateTime?

  // Relations
  roles                 UserRole[]
  sessions              Session[]
  auditLogs             AuditLog[]
  devices               Device[]
  viewerProfile         ViewerProfile?
  creatorProfile        CreatorProfile?

  @@index([email])
  @@index([accountState])
}

// Role-based access control
model Role {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?
  permissions Permission[]
  users       UserRole[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([name])
}

// Permissions for each role
model Permission {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?
  resource    String    // e.g., "users", "streams", "payments"
  action      String    // e.g., "create", "read", "update", "delete"
  roles       Role[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([resource, action])
  @@index([resource])
}

// User role assignment
model UserRole {
  id        String   @id @default(cuid())
  userId    String
  roleId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
}

// Session management
model Session {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Token info
  refreshToken  String   @unique
  accessToken   String?

  // Device tracking
  deviceId      String?
  ipAddress     String
  userAgent     String

  // Timing
  createdAt     DateTime @default(now())
  expiresAt     DateTime
  revokedAt     DateTime?
  lastActivityAt DateTime @default(now())

  @@index([userId])
  @@index([refreshToken])
  @@index([expiresAt])
}

// Device tracking for multi-device sessions
model Device {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  name          String?
  type          String    // mobile, desktop, tablet
  os            String?
  browser       String?

  ipAddress     String
  lastIpAddress String?

  // Security
  trustedUntil  DateTime?
  isVerified    Boolean   @default(false)

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastUsedAt    DateTime?

  @@index([userId])
}

// Audit log for compliance
model AuditLog {
  id            String   @id @default(cuid())
  userId        String?
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  action        String   // e.g., "user.login", "user.mfa.enable", "user.password.change"
  resource      String   // e.g., "user", "session", "role"
  resourceId    String?  // ID of affected resource

  ipAddress     String?
  userAgent     String?

  changes       Json?    // What changed (oldValue -> newValue)
  status        String   @default("success") // success, failure
  errorMessage  String?

  createdAt     DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([resourceId])
  @@index([createdAt])
}

// Login attempt tracking for security
model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  ipAddress String
  successful Boolean
  reason    String?  // "invalid_password", "mfa_required", etc.
  userAgent String?
  createdAt DateTime @default(now())

  @@index([email])
  @@index([ipAddress])
  @@index([createdAt])
}

// Password reset tokens
model PasswordReset {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
}

// Email verification tokens
model EmailVerification {
  id        String   @id @default(cuid())
  userId    String
  email     String
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([email])
  @@index([token])
}

// ============= PHASE 2: PROFILES & CREATOR ONBOARDING =============

// Viewer profile information
model ViewerProfile {
  id                    String    @id @default(cuid())
  userId                String    @unique
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Profile
  bio                   String?   @db.Text
  birthDate             DateTime?
  gender                String?   // male, female, other
  location              String?

  // Preferences
  language              String    @default("en")
  timezone              String    @default("UTC")
  profileVisibility     String    @default("public") // public, private
  activityVisibility    Boolean   @default(true)

  // Notifications
  emailNotifications    Boolean   @default(true)
  pushNotifications     Boolean   @default(true)

  // Social
  followerCount         Int       @default(0)
  followingCount        Int       @default(0)

  // Audit
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  blockedUsers          UserBlock[]   @relation("blocker")
  blockedByUsers        UserBlock[]   @relation("blocked")
  reports               UserReport[]
  subscriptions         CreatorSubscription[]

  // Payment relations
  paymentMethods        PaymentMethod[]
  payerTransactions     Transaction[] @relation("PayerTransactions")

  @@index([userId])
}

// Creator profile information
model CreatorProfile {
  id                    String    @id @default(cuid())
  userId                String    @unique
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Profile
  bio                   String?   @db.Text
  categories            String[]  @default([])
  languages             String[]  @default(["en"])

  // Status
  verificationStatus    String    @default("pending") // pending, approved, rejected, expired
  isMonetized           Boolean   @default(false)
  creatorSince          DateTime  @default(now())

  // Configuration
  minTipAmount          Decimal   @default(1.00) @db.Decimal(10, 2)
  geoBlockedCountries   String[]  @default([])

  // Stats
  totalEarnings         Decimal   @default(0.00) @db.Decimal(15, 2)
  totalFollowers        Int       @default(0)
  totalStreams          Int       @default(0)

  // Payout
  payoutMethodId        String?
  payoutFrequency       String    @default("weekly") // daily, weekly, monthly
  minimumPayoutAmount   Decimal   @default(10.00) @db.Decimal(10, 2)

  // Audit
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  verificationUpdatedAt DateTime?

  application           CreatorApplication?
  verification          CreatorVerification?
  tipMenus              TipMenu[]
  schedules             StreamSchedule[]
  linkedStudios         StudioCreator[]
  subscriptions         CreatorSubscription[]

  // Payment relations
  stripeAccount         StripeAccount?
  recipientTransactions Transaction[]
  payouts               Payout[]
  paymentReports        PaymentReport[]

  @@index([userId])
  @@index([verificationStatus])
  @@index([isMonetized])
}

// Creator application workflow
model CreatorApplication {
  id                    String    @id @default(cuid())
  creatorProfileId      String    @unique
  creatorProfile        CreatorProfile @relation(fields: [creatorProfileId], references: [id], onDelete: Cascade)

  // Application details
  status                String    @default("pending") // pending, approved, rejected, needs_revision
  submittedAt           DateTime  @default(now())
  reviewedAt            DateTime?
  reviewedBy            String?

  // Application data
  reasonForRejection    String?   @db.Text
  notes                 String?   @db.Text

  // Revision tracking
  revisionCount         Int       @default(0)
  lastRevisionAt        DateTime?

  // Audit
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([status])
  @@index([submittedAt])
}

// Creator verification status
model CreatorVerification {
  id                    String    @id @default(cuid())
  creatorProfileId      String    @unique
  creatorProfile        CreatorProfile @relation(fields: [creatorProfileId], references: [id], onDelete: Cascade)

  // Verification status
  status                String    @default("pending") // pending, approved, rejected, expired
  expiresAt             DateTime?

  // Age verification
  ageVerified           Boolean   @default(false)
  ageVerifiedAt         DateTime?
  ageVerificationMethod String?   // onfido, au10tec, manual

  // Identity verification
  identityVerified      Boolean   @default(false)
  identityVerifiedAt    DateTime?
  identityDocument      String?   // Stored securely, reference only

  // Liveness check
  livenessVerified      Boolean   @default(false)
  livenessVerifiedAt    DateTime?

  // Performer consent
  consentGiven          Boolean   @default(false)
  consentGivenAt        DateTime?
  consentDocuments      String[]  @default([])

  // Audit
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([status])
  @@index([expiresAt])
}

// Tip menu configuration
model TipMenu {
  id                    String    @id @default(cuid())
  creatorProfileId      String
  creatorProfile        CreatorProfile @relation(fields: [creatorProfileId], references: [id], onDelete: Cascade)

  // Tip details
  label                 String    // "Small Tip", "Coffee", etc.
  amount                Decimal   @db.Decimal(10, 2)
  icon                  String?   // emoji or icon identifier
  order                 Int       // display order
  isActive              Boolean   @default(true)

  // Audit
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([creatorProfileId, label])
  @@index([creatorProfileId])
  @@index([isActive])
}

// Stream schedule for creators
model StreamSchedule {
  id                    String    @id @default(cuid())
  creatorProfileId      String
  creatorProfile        CreatorProfile @relation(fields: [creatorProfileId], references: [id], onDelete: Cascade)

  // Schedule
  dayOfWeek             Int       // 0-6 (Sunday-Saturday)
  startTime             String    // "14:00" (HH:mm format)
  endTime               String    // "20:00" (HH:mm format)
  timezone              String    @default("UTC")

  // Settings
  isActive              Boolean   @default(true)
  notifyFollowers       Boolean   @default(true)

  // Audit
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([creatorProfileId, dayOfWeek])
  @@index([creatorProfileId])
  @@index([isActive])
}

// User blocking
model UserBlock {
  id                    String    @id @default(cuid())
  blockerProfileId      String
  blockerProfile        ViewerProfile @relation("blocker", fields: [blockerProfileId], references: [id], onDelete: Cascade)

  blockedProfileId      String
  blockedProfile        ViewerProfile @relation("blocked", fields: [blockedProfileId], references: [id], onDelete: Cascade)

  reason                String?
  createdAt             DateTime  @default(now())

  @@unique([blockerProfileId, blockedProfileId])
  @@index([blockerProfileId])
  @@index([blockedProfileId])
}

// User/content reporting
model UserReport {
  id                    String    @id @default(cuid())
  reporterProfileId     String
  reporterProfile       ViewerProfile @relation(fields: [reporterProfileId], references: [id], onDelete: Cascade)

  // Report subject
  reportedUserId        String    // User ID being reported
  contentType           String    // profile, stream, message, comment
  contentId             String?   // ID of reported content

  // Report details
  category              String    // harassment, spam, inappropriate_content, scam, etc.
  description           String?   @db.Text
  evidence              String[]  @default([])

  // Status
  status                String    @default("pending") // pending, reviewing, resolved, dismissed
  resolution            String?   // Action taken
  resolvedAt            DateTime?
  resolvedBy            String?

  // Audit
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([reportedUserId])
  @@index([status])
  @@index([category])
  @@index([createdAt])
}

// Studio/Agency management
model Studio {
  id                    String    @id @default(cuid())
  ownerId               String

  // Studio info
  name                  String
  description           String?   @db.Text
  legalName             String?
  taxId                 String?

  // Contact
  email                 String
  phoneNumber           String?
  website               String?

  // Verification
  isVerified            Boolean   @default(false)
  verifiedAt            DateTime?

  // Settings
  commissionPercentage  Decimal   @default(30.00) @db.Decimal(5, 2)
  payoutAccount         String?

  // Audit
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  linkedCreators        StudioCreator[]

  @@index([ownerId])
  @@index([isVerified])
}

// Link creators to studios
model StudioCreator {
  id                    String    @id @default(cuid())
  studioId              String
  studio                Studio    @relation(fields: [studioId], references: [id], onDelete: Cascade)

  creatorProfileId      String
  creatorProfile        CreatorProfile @relation(fields: [creatorProfileId], references: [id], onDelete: Cascade)

  // Relationship
  role                  String    @default("performer") // owner, manager, performer
  contractStart         DateTime?
  contractEnd           DateTime?
  isActive              Boolean   @default(true)

  // Permissions
  canManageProfile      Boolean   @default(false)
  canAccessEarnings     Boolean   @default(false)
  canManagePayout       Boolean   @default(false)

  // Audit
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([studioId, creatorProfileId])
  @@index([studioId])
  @@index([creatorProfileId])
  @@index([isActive])
}

// Creator subscriptions
model CreatorSubscription {
  id                    String    @id @default(cuid())
  subscriberProfileId   String
  subscriberProfile     ViewerProfile @relation(fields: [subscriberProfileId], references: [id], onDelete: Cascade)

  creatorProfileId      String
  creatorProfile        CreatorProfile @relation(fields: [creatorProfileId], references: [id], onDelete: Cascade)

  // Subscription details
  tier                  String    // gold, silver, bronze (custom names)
  price                 Decimal   @db.Decimal(10, 2)

  // Status
  status                String    @default("active") // active, paused, cancelled
  renewalDate           DateTime
  cancelledAt           DateTime?

  // Audit
  subscribedAt          DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([subscriberProfileId, creatorProfileId])
  @@index([subscriberProfileId])
  @@index([creatorProfileId])
  @@index([status])
}

// Phase 3: Payment & Monetization

// Stripe account for creators
model StripeAccount {
  id                    String    @id @default(cuid())
  creatorProfileId      String    @unique
  creatorProfile        CreatorProfile @relation(fields: [creatorProfileId], references: [id], onDelete: Cascade)

  // Stripe details
  stripeAccountId       String    @unique
  accountStatus         String    @default("pending") // pending, active, restricted, suspended
  accountType           String    @default("express") // standard, express

  // Verification
  chargesEnabled        Boolean   @default(false)
  payoutsEnabled        Boolean   @default(false)
  verificationStatus    String    @default("unverified") // unverified, verified, restricted

  // Banking info
  bankAccountId         String?   @unique
  bankAccountLastFour   String?
  bankAccountBrand      String?

  // Tax info
  taxId                 String?
  businessType          String?   // individual, sole_proprietor, partnership, corporation

  // Audit
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  connectedAt           DateTime?
  disconnectedAt        DateTime?

  @@index([stripeAccountId])
  @@index([accountStatus])
}

// Payment methods (credit cards, etc)
model PaymentMethod {
  id                    String    @id @default(cuid())
  viewerProfileId       String
  viewerProfile         ViewerProfile @relation(fields: [viewerProfileId], references: [id], onDelete: Cascade)

  // Stripe details
  stripePaymentMethodId String    @unique
  type                  String    // card, bank_account

  // Card details (if card)
  cardBrand             String?   // visa, mastercard, amex, discover
  cardLastFour          String?
  cardExpMonth          Int?
  cardExpYear           Int?

  // Bank account details (if bank)
  bankAccountLastFour   String?
  bankRoutingNumber     String?

  // Status
  isDefault             Boolean   @default(false)
  isValid               Boolean   @default(true)

  // Audit
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  deletedAt             DateTime?

  @@index([viewerProfileId])
  @@index([stripePaymentMethodId])
}

// Transactions (tips, subscriptions, etc)
model Transaction {
  id                    String    @id @default(cuid())
  stripeTransactionId   String?   @unique

  // Payer (viewer)
  payerProfileId        String
  payerProfile          ViewerProfile @relation("PayerTransactions", fields: [payerProfileId], references: [id], onDelete: Cascade)

  // Recipient (creator)
  recipientProfileId    String
  recipientProfile      CreatorProfile @relation(fields: [recipientProfileId], references: [id], onDelete: Cascade)

  // Transaction details
  type                  String    // tip, subscription, purchase
  amount                Decimal   @db.Decimal(10, 2)
  currency              String    @default("usd")

  // Fee breakdown
  platformFee           Decimal   @db.Decimal(10, 2)
  stripeFee             Decimal   @db.Decimal(10, 2)
  creatorEarnings       Decimal   @db.Decimal(10, 2)

  // Subscription details (if applicable)
  subscriptionTier      String?
  subscriptionId        String?
  billingCycleStart     DateTime?
  billingCycleEnd       DateTime?

  // Status
  status                String    @default("pending") // pending, processing, succeeded, failed, refunded
  failureReason         String?

  // Dispute
  isDisputed            Boolean   @default(false)
  disputes              PaymentDispute[]

  // Metadata
  description           String?
  metadata              String?   @db.Text // JSON string for custom data

  // Audit
  createdAt             DateTime  @default(now())
  processedAt           DateTime?
  updatedAt             DateTime  @updatedAt

  @@index([payerProfileId])
  @@index([recipientProfileId])
  @@index([status])
  @@index([type])
  @@index([createdAt])
}

// Creator payouts
model Payout {
  id                    String    @id @default(cuid())
  stripPayoutId         String?   @unique

  creatorProfileId      String
  creatorProfile        CreatorProfile @relation(fields: [creatorProfileId], references: [id], onDelete: Cascade)

  // Payout details
  amount                Decimal   @db.Decimal(10, 2)
  currency              String    @default("usd")

  // Period
  payoutPeriodStart     DateTime
  payoutPeriodEnd       DateTime

  // Status
  status                String    @default("pending") // pending, processing, paid, failed, cancelled
  failureReason         String?

  // Metadata
  bankAccount           String?   // Last 4 digits or identifier
  description           String?

  // Audit
  createdAt             DateTime  @default(now())
  processedAt           DateTime?
  completedAt           DateTime?
  updatedAt             DateTime  @updatedAt

  @@index([creatorProfileId])
  @@index([status])
  @@index([payoutPeriodStart])
}

// Payment disputes/chargebacks
model PaymentDispute {
  id                    String    @id @default(cuid())
  stripeDisputeId       String?   @unique
  transactionId         String
  transaction           Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  // Dispute details
  reason                String    // chargeback, fraud, product_unacceptable, etc
  amount                Decimal   @db.Decimal(10, 2)
  currency              String    @default("usd")

  // Status
  status                String    @default("open") // open, warning_needs_response, warning_under_review, warning_closed, lost, won, warning_won

  // Evidence
  customerStatement     String?   @db.Text
  evidence              String[]  @default([]) // JSON array of URLs

  // Timeline
  dueDateAt             DateTime?
  closedAt              DateTime?

  // Audit
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([transactionId])
  @@index([status])
}

// Financial reports for creators
model PaymentReport {
  id                    String    @id @default(cuid())
  creatorProfileId      String
  creatorProfile        CreatorProfile @relation(fields: [creatorProfileId], references: [id], onDelete: Cascade)

  // Period
  reportPeriodStart     DateTime
  reportPeriodEnd       DateTime

  // Summary
  totalRevenue          Decimal   @db.Decimal(12, 2)
  totalTips             Decimal   @db.Decimal(12, 2)
  totalSubscriptions    Decimal   @db.Decimal(12, 2)
  totalPlatformFees     Decimal   @db.Decimal(12, 2)
  totalStripeFees       Decimal   @db.Decimal(12, 2)
  totalPayouts          Decimal   @db.Decimal(12, 2)

  // Metrics
  totalTransactions     Int
  uniquePatrons        Int
  averageTransaction    Decimal   @db.Decimal(10, 2)

  // Breakdown
  topTransactionTypes   String    @db.Text // JSON object
  topTipAmounts         String    @db.Text // JSON array

  // File storage
  pdfUrl                String?
  csvUrl                String?

  // Audit
  createdAt             DateTime  @default(now())
  generatedAt           DateTime?
  updatedAt             DateTime  @updatedAt

  @@unique([creatorProfileId, reportPeriodStart, reportPeriodEnd])
  @@index([creatorProfileId])
  @@index([reportPeriodStart])
}

// Add relations to existing models
// ViewerProfile: add paymentMethods and transactions as payer
// CreatorProfile: add stripeAccount, transactions as recipient, payouts, reports
